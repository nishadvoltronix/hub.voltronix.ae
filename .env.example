# One project, one root .env: copy this template to .env before Hub build/start.
# The launcher reads this file for both application services. Explicit process
# settings override file values. Never publish or commit your actual .env file.
# Database-disabled mode is the default; native MySQL configuration is below.
# Zoho outbound workflows require the explicit verified profile below.
# 3301/3302 are examples: verify both ports are free before choosing them.
# Use plain values (optional quotes); no expansion or multiline values.
# Credentials belong only in your ignored .env, never in this example file.
NODE_ENV=production
APP_ORIGIN=https://hub.voltronix.ae
CRM_API_INSTANCE_ID=hub-crm
CRM_DATABASE_MODE=disabled
CRM_MYSQL_NETWORK_DISABLED=1
ZOHO_ENABLED=false
NEXT_TELEMETRY_DISABLED=1
CRM_WEB_HOST=127.0.0.1
CRM_WEB_PORT=3301
CRM_FRONTEND_BACKEND=express
CRM_EXPRESS_ORIGIN=http://127.0.0.1:3302
CRM_API_ENVIRONMENT=production
CRM_API_HOST=127.0.0.1
CRM_API_PORT=3302

# Native MySQL: use only a provisioned Hub schema that passes runtime readiness.
# Replace the two active mode settings above; do not leave duplicate assignments.
# CRM_DATABASE_MODE=mysql-native
# CRM_MYSQL_NETWORK_DISABLED=0
# CRM_RUNTIME_ENABLE=approved-production-mysql-crm-runtime
# CRM_RUNTIME_SOURCE=environment
# CRM_MYSQL_HOST=127.0.0.1
# CRM_MYSQL_PORT=3306
# CRM_MYSQL_DATABASE=<provisioned-hub-schema>
# CRM_MYSQL_USER=<dedicated-runtime-user>
# CRM_MYSQL_PASSWORD=<private-runtime-password>
# CRM_MYSQL_SERVER_UUID=<verified-server-uuid>
# CRM_MYSQL_APPROVED=true
# CRM_MYSQL_APPROVAL_REFERENCE=<actual-owner-approval>
# CRM_MYSQL_PROVISIONING_REFERENCE=<actual-provisioning-reference>
# CRM_MYSQL_ISSUER_COMPANY=<supported-company>
# CRM_MYSQL_ISSUER_SALESPERSON=<display-name>
# Startup verifies identity, grants and native schema; it never runs migrations.
# This mode does not make the historical PHP CRM database compatible.

# Optional Zoho metadata check; these credentials do not enable synchronization.
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# For a confirmed US Zoho account: npm run hub:check:zoho -- --data-center=us
# To inspect the retained Voltronix mappings, append:
# --account-profile=standard-account-contact-email-v1 --deal-profile=legacy-conversion-fields-v1 --stage-profile=voltronix-stage-labels-v1

# Native outbound Zoho: keep ZOHO_ENABLED=false until the fresh Hub database,
# protected user bindings, pinned organization/owner and selected profile pass.
# This sends explicitly requested workflows; it does not import existing CRM rows.
# ZOHO_ORGANIZATION_ID=<independently-confirmed-production-organization-id>
# ZOHO_ACCOUNT_OWNER_ID=<confirmed-current-zoho-user-id>
# ZOHO_PROFILE=voltronix-native-outbound-v1
# ZOHO_DEAL_PIPELINE="Standard (Standard)"
# ZOHO_AUTOMATION_POLICY=suppressed
# Replace ZOHO_ENABLED=false with true only after verified native acceptance.
# Optional emergency veto: ZOHO_NETWORK_DISABLED=1 (startup then fails closed).
# All database and Zoho settings remain blank in the Next.js child environment.

# Optional initial import and ongoing read-only Zoho-to-Hub polling.
# Uses the same private credentials and independently confirmed organization.
# The principal must already be active with users.write and permissions.manage.
# No user or permission is created by synchronization; provision the first admin explicitly.
# ZOHO_SYNC_ENABLED=false
# ZOHO_SYNC_INTERVAL_SECONDS=300
# ZOHO_SYNC_PRINCIPAL_ID=<existing-authorized-native-administrator-id>
# Enable only after the native v5 schema and bounded initial import are verified.
# Manual read-only check: node tools/sync-zoho.mjs check
# One initial/incremental pass: node tools/sync-zoho.mjs run
# Build/check never start polling; only actual API serving starts the enabled worker.
