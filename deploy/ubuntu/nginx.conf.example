# MANUAL TEMPLATE ONLY. Include from the existing nginx http {} context, such
# as one reviewed sites-enabled file. Do not replace the server-wide nginx.conf.
# For hub.voltronix.ae ONLY. Never add default_server or a wildcard name.
# Confirm free ports, existing virtual hosts, certificate/key paths and domain
# control before install. Run nginx -t before any separately authorized reload.
# Certificate provisioning/renewal is external owner work, never done by CRM.

# Status-only access evidence: no URL/query, IP/user, Referer, cookies or body.
log_format hub_crm_safe '$time_iso8601 method=$request_method status=$status '
    'bytes=$body_bytes_sent seconds=$request_time upstream=$upstream_status';

upstream hub_crm_next {
    server 127.0.0.1:3301;
    keepalive 16;
}

server {
    listen 80;
    server_name hub.voltronix.ae;
    server_tokens off;
    access_log /var/log/nginx/hub-crm-access.log hub_crm_safe;
    error_log stderr crit;

    if ($host != hub.voltronix.ae) { return 444; }

    # An owner-selected HTTP-01 certificate client may use this bounded public
    # challenge directory. No application files are served from this directory.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/hub.voltronix_ae/hub-acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
        return 308 https://hub.voltronix.ae$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name hub.voltronix.ae;
    server_tokens off;
    ssl_certificate /etc/letsencrypt/live/hub.voltronix.ae/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hub.voltronix.ae/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    if ($host != hub.voltronix.ae) { return 444; }
    access_log /var/log/nginx/hub-crm-access.log hub_crm_safe;
    # Critical diagnostics go to the restricted nginx/systemd journal. Nginx
    # error records cannot use the redacted access format and can include a URI:
    # restrict journal readers and redact before sharing. Never enable debug.
    error_log stderr crit;

    # Enable HSTS only after this host's certificate and HTTPS acceptance pass.
    # No includeSubDomains/preload: ownership of sibling hosts is not assumed.
    # add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # Additional upstream attachment CSP (sandbox/default-src none) is retained;
    # multiple CSP policies intersect, so protected-download isolation survives.
    add_header Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'none'" always;

    # This is an outer request ceiling, not a replacement for authorization,
    # format validation or exact per-route Express/Next body and file limits.
    client_max_body_size 52m;
    client_body_timeout 15s;
    send_timeout 35s;
    keepalive_timeout 15s;

    proxy_http_version 1.1;
    proxy_set_header Host hub.voltronix.ae;
    proxy_set_header Connection "";
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-Proto "";
    proxy_set_header X-Real-IP "";
    # Origin, Cookie, Sec-Fetch-Site and X-CSRF-Token are never rewritten.
    # The application uses its explicit APP_ORIGIN, not proxy headers, for
    # secure cookie names and CSRF. No browser route exposes Express directly.
    proxy_hide_header X-Powered-By;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Permissions-Policy;
    proxy_connect_timeout 3s;
    proxy_send_timeout 35s;
    proxy_read_timeout 35s;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_cache off;
    proxy_intercept_errors off;

    location = /api/v1 { return 404; }
    location ^~ /api/v1/ { return 404; }
    location ~* ^/(server|src|resources|tests|scripts|node_modules|backend|frontend|shared|deploy|docs|tools|application|system|vendor|include|assets|uploads|backups)(/|$) { return 404; }
    location ~ (^|/)\. { return 404; }
    location ~* \.(php[0-9]*|phtml|sql|sqlite[0-9]*|db|bak|backup|pem|key|log)$ { return 404; }

    # Includes public /api/... -> Next's server-only bridge -> 127.0.0.1:3302.
    # Next static/visual assets stay behind this same host. There is no alias or
    # root exposing any backend, original upload, local data or private profile.
    location / {
        proxy_pass http://hub_crm_next;
    }
}
