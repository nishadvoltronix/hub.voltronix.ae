{
  "name": "hub-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single-root Next.js CRM and Express API; database activation remains an explicit separate operation.",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "hub:dev": "node --import tsx tools/run-hub.mjs dev",
    "hub:build": "node tools/run-hub.mjs build",
    "hub:check": "node tools/run-hub.mjs check",
    "hub:start": "node tools/run-hub.mjs start",
    "hub:check:web": "node tools/run-hub.mjs check-web",
    "hub:check:api": "node tools/run-hub.mjs check-api",
    "hub:start:web": "node tools/run-hub.mjs web",
    "hub:start:api": "node tools/run-hub.mjs api",
    "dev": "node --import tsx tools/run-hub.mjs dev",
    "legacy:dev": "npm run contracts:build && node tools/run-local.mjs dev",
    "legacy:dev:web": "npm run contracts:build && node tools/run-local.mjs web:dev",
    "legacy:dev:api": "npm run contracts:build && node --import tsx tools/run-local.mjs api:foundation-dev",
    "contracts:build": "tsc -p shared/contracts/tsconfig.json",
    "build:server": "tsc -p tsconfig.server.build.json",
    "build:web": "next build",
    "build": "node tools/run-hub.mjs build",
    "start": "node tools/run-hub.mjs start",
    "legacy:build": "npm run contracts:build && npm run build:server && npm run build:web",
    "legacy:start": "node tools/run-local.mjs start",
    "legacy:start:web": "node tools/run-local.mjs web:start",
    "legacy:start:api": "node tools/run-local.mjs api:foundation",
    "start:api:configured": "node server/dist/cli.js",
    "lint": "eslint src tests scripts server/src server/tests server/scripts server/demo-sqlite shared/contracts/src next.config.ts",
    "typecheck:web": "next typegen && tsc -p tsconfig.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:demo": "tsc -p tsconfig.demo.json --noEmit",
    "typecheck": "npm run contracts:build && npm run typecheck:web && npm run typecheck:server && npm run typecheck:demo",
    "test:web": "npm run contracts:build && tsx --test --test-concurrency=2 tests/*.test.ts",
    "test:server": "npm run contracts:build && npm run build:server && node tools/run-local.mjs test:server",
    "test:demo": "npm run contracts:build && node tools/run-local.mjs test:demo",
    "test:tools": "node --test tools/*.test.mjs",
    "test": "npm run test:server && npm run test:demo && npm run test:web && npm run test:tools",
    "verify:boundaries": "node tools/run-local.mjs server:script scripts/verify-boundaries.ts",
    "verify:mysql-auth": "node tools/run-local.mjs server:script scripts/mysql-auth-harness.ts",
    "verify:crm-demo": "node tools/run-local.mjs server:script scripts/crm-demo-harness.ts",
    "migration:plan": "node tools/run-local.mjs server:script scripts/check-migrations.ts",
    "mysql:operator": "node tools/run-local.mjs server:built dist/operations/mysql-cli.js",
    "verify:preservation": "node tools/run-local.mjs server:script scripts/check-preservation.ts",
    "config:check": "node tools/run-local.mjs server:script scripts/check-runtime.ts",
    "config:check:web": "tsx scripts/check-frontend-config.ts",
    "legacy:check": "node tools/run-local.mjs server:script scripts/check-legacy.ts",
    "zoho:setup": "node tools/run-local.mjs server:script scripts/zoho-setup.ts",
    "hub:check:zoho": "node tools/check-hub-zoho.mjs",
    "hub:sync:zoho": "node tools/sync-zoho.mjs",
    "zoho:check": "node tools/run-local.mjs server:script scripts/zoho-setup.ts --check",
    "zoho:inspect": "node tools/run-local.mjs server:script scripts/zoho-inspect.ts",
    "zoho:import:local": "node tools/run-local.mjs server:script demo-sqlite/zoho-import.ts",
    "zoho:sandbox:setup": "node tools/run-local.mjs server:script scripts/zoho-sandbox.ts setup",
    "zoho:sandbox:check": "node tools/run-local.mjs server:script scripts/zoho-sandbox.ts check",
    "demo:sqlite:init": "node tools/run-local.mjs server:script demo-sqlite/control.ts init",
    "demo:sqlite:start": "node tools/run-local.mjs server:script demo-sqlite/control.ts start",
    "demo:sqlite:stop": "node tools/run-local.mjs server:script demo-sqlite/control.ts stop",
    "demo:sqlite:status": "node tools/run-local.mjs server:script demo-sqlite/control.ts status",
    "demo:sqlite:verify": "node tools/run-local.mjs server:script demo-sqlite/control.ts verify",
    "demo:sqlite:verify-anonymous": "node tools/run-local.mjs server:script demo-sqlite/control.ts verify-anonymous",
    "demo:sqlite:backup": "node tools/run-local.mjs server:script demo-sqlite/control.ts backup",
    "demo:sqlite:api": "node tools/run-local.mjs server:script demo-sqlite/api.ts",
    "demo:sqlite:typecheck": "npm run typecheck:demo",
    "demo:sqlite:test": "npm run test:demo",
    "test:mysql-auth:offline": "node tools/run-local.mjs test:mysql-auth:offline",
    "test:http": "tsx scripts/verify-mysql-offline-http.ts",
    "test:settings:http": "tsx scripts/verify-settings-http.ts",
    "mysql:config": "tsx scripts/mysql-config.ts",
    "mysql:inspect": "tsx scripts/mysql-inspect.ts",
    "verify:local": "tsx scripts/verify-local-evidence.ts",
    "staging:http": "tsx scripts/verify-staging-http.ts",
    "db:inspect": "tsx scripts/sqlite-command-gate.ts",
    "db:migrate": "tsx scripts/sqlite-command-gate.ts",
    "db:backup": "tsx scripts/sqlite-command-gate.ts",
    "db:verify-backup": "tsx scripts/sqlite-command-gate.ts",
    "dev:user": "tsx scripts/create-development-user.ts",
    "sqlite:inspect": "tsx scripts/inspect-schema.ts",
    "sqlite:migrate": "tsx scripts/migrate.ts",
    "sqlite:backup": "tsx scripts/backup.ts",
    "sqlite:verify-backup": "tsx scripts/verify-backup.ts",
    "sqlite:config": "tsx scripts/check-config.ts",
    "test:sqlite:http": "tsx scripts/verify-auth-http.ts && tsx scripts/verify-settings-http.ts && tsx scripts/verify-crm-http.ts && tsx scripts/verify-lead-mutations-http.ts && tsx scripts/verify-workflows-http.ts && tsx scripts/verify-commercial-http.ts",
    "mysql:migrate": "tsx scripts/mysql-migrate.ts",
    "test:mysql": "tsx scripts/run-mysql-integration.ts"
  },
  "dependencies": {
    "@next/env": "16.4.3",
    "@voltronix/crm-contracts": "file:./shared/contracts",
    "bcryptjs": "3.0.3",
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "fflate": "0.8.3",
    "helmet": "8.3.0",
    "mysql2": "3.24.5",
    "next": "16.4.3",
    "pdfkit": "0.20.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pdfkit": "0.17.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "pdfjs-dist": "6.4.299",
    "playwright": "1.64.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
